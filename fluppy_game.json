},
"discount_22_requirements": {
"minimum_final_score": 90,
"minimum_passed_obstacles": 23,
"minimum_clean_pass_ratio": 0.6
},
"fallback_rule": "Если score попал в высокий диапазон, но дополнительные требования не выполнены, скидка понижается до максимального диапазона, требованиям которого соответствует сессия."
},
"anti_bot": {
"enabled": true,
"security_risk_score_range": [
0,
100
],
"hard_rejection_threshold": 70,
"manual_review_threshold": 40,
"rules": [
{
"id": "flap_rate_over_limit",
"description": "Более 10 валидных тапов в любом скользящем окне 1 секунды.",
"risk_points": 25,
"count_excess_taps": false
},
{
"id": "sub_90ms_intervals",
"description": "Повторяющиеся интервалы между тапами короче разрешенного лимита.",
"condition": "three_or_more_intervals_below_90ms",
"risk_points": 25
},
{
"id": "synthetic_event",
"description": "Событие не было инициировано реальным пользователем.",
"condition": "event.isTrusted_is_false",
"risk_points": 100,
"immediate_rejection": true
},
{
"id": "multi_pointer_input",
"description": "Одновременно обнаружено более одного указателя.",
"risk_points": 20,
"count_secondary_taps": false
},
{
"id": "machine_regular_input",
"description": "Подозрительно одинаковые интервалы между тапами.",
"condition": "at_least_15_intervals AND interval_standard_deviation_below_2.5ms",
"risk_points": 35
},
{
"id": "repeating_input_sequence",
"description": "Одинаковый временной паттерн тапов повторяется несколько раз.",
"condition": "same_sequence_of_4_or_more_intervals_repeats_4_times_with_tolerance_2ms",
"risk_points": 30
},
{
"id": "impossible_trajectory",
"description": "Клиент сообщает траекторию, невозможную при утвержденной физике.",
"condition": "server_reconstructed_position_diff_exceeds_tolerance",
"risk_points": 100,
"immediate_rejection": true
},
{
"id": "obstacle_sequence_mismatch",
"description": "Клиентская последовательность препятствий не соответствует серверному seed.",
"risk_points": 100,
"immediate_rejection": true
},
{
"id": "collision_bypass",
"description": "Клиент продолжил игру после столкновения, подтвержденного серверной реконструкцией.",
"risk_points": 100,
"immediate_rejection": true
},
{
"id": "background_play",
"description": "Тапы или игровая симуляция продолжались в скрытой вкладке.",
"condition": "document.visibilityState_is_not_visible",
"risk_points": 100,
"immediate_rejection": true
},
{
"id": "time_scale_manipulation",
"description": "Изменение скорости игрового времени или расхождение monotonic timestamps.",
"condition": "client_elapsed_time_differs_from_server_elapsed_time_above_tolerance",
"risk_points": 80,
"immediate_rejection": true
},
{
"id": "identical_session_replay",
"description": "Несколько сессий имеют идентичные последовательности тапов и прохождения.",
"condition": "input_sequence_similarity_above_0.995_across_sessions",
"risk_points": 60
}
],
"response": {
"risk_score_0_to_39": {
"session_valid": true,
"reward_allowed": true
},
"risk_score_40_to_69": {
"session_valid": true,
"reward_allowed": true,
"score_multiplier": 0.75,
"log_for_analysis": true
},
"risk_score_70_to_99": {
"session_valid": false,
"reward_allowed": false,
"user_message": "We couldn't verify this flight. Please try again."
},
"risk_score_100": {
"session_valid": false,
"reward_allowed": false,
"temporary_session_block_minutes": 30
}
},
"server_validation": {
"required_for_reward": true,
"server_generates_session_seed": true,
"server_generates_obstacle_sequence": true,
"send_raw_tap_timestamps": true,
"send_pointer_ids": true,
"send_visibility_changes": true,
"send_client_collision_timestamp": true,
"reconstruct_full_trajectory_on_server": true,
"recalculate_score_on_server": true,
"client_result_is_not_authoritative": true,
"request_signature_required": true,
"session_nonce_required": true,
"nonce_single_use": true,
"maximum_session_age_seconds": 90,
"physics_version_must_match": true
}
},
"randomization": {
