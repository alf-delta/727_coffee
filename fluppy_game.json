},
{
"survival_seconds": 22,
"score": 0.8
},
{
"survival_seconds": 30,
"score": 0.92
},
{
"survival_seconds": 40,
"score": 1
}
]
},
"input_efficiency_score": {
"description": "Штрафует бессмысленный спам тапами, но не требует идеального числа нажатий.",
"formula": "efficiency = expected_flap_count_for_path / max(actual_valid_flap_count, expected_flap_count_for_path)",
"expected_flap_count_method": "physics_reconstruction",
"minimum_score": 0.5,
"maximum_score": 1,
"spam_threshold_ratio": 1.8
}
},
"final_score": {
"output_range": [
0,
100
],
"components": {
"distance_score_weight": 0.58,
"accuracy_score_weight": 0.18,
"streak_score_weight": 0.14,
"survival_score_weight": 0.07,
"input_efficiency_score_weight": 0.03
},
"base_formula": "base_score = 100 * (0.58 * distance_score + 0.18 * accuracy_score + 0.14 * streak_score + 0.07 * survival_score + 0.03 * input_efficiency_score)",
"multipliers": {
"clean_run_bonus": {
"condition": "clean_pass_ratio_above_0.8 AND passed_obstacles_at_least_12",
"multiplier": 1.04
},
"perfect_streak_bonus": {
"condition": "longest_clean_streak_at_least_10 AND perfect_pass_ratio_above_0.35",
"multiplier": 1.03
},
"tap_spam_penalty": {
"condition": "actual_flaps_greater_than_expected_flaps_times_1.8",
"multiplier": 0.9
},
"security_suspicion_penalty": {
"condition": "security_risk_score_between_40_and_69",
"multiplier": 0.75
}
},
"score_caps": [
{
"condition": "passed_obstacles_below_8",
"maximum_score": 52
},
{
"condition": "passed_obstacles_below_15",
"maximum_score": 76
},
{
"condition": "passed_obstacles_below_22",
"maximum_score": 88
},
{
"condition": "accuracy_score_below_0.6",
"maximum_score": 84
},
{
"condition": "longest_clean_streak_below_6",
"maximum_score": 87
}
],
"rounding": {
"internal_precision_decimal_places": 4,
"displayed_score_decimal_places": 0
}
},
"discount_mapping": {
"method": "threshold_bands_with_requirements",
"principle": "Первые скидки достигаются достаточно быстро, но верхние 22-25% требуют длинной чистой серии и большого количества препятствий.",
