"score": 0.9
},
{
"longest_clean_streak": 18,
"score": 1
}
]
},
"survival_score": {
"description": "Дополнительная оценка продолжительности сессии.",
"curve": [
{
"survival_seconds": 0,
"score": 0
},
{
"survival_seconds": 5,
"score": 0.2
},
{
"survival_seconds": 10,
"score": 0.42
},
{
"survival_seconds": 15,
