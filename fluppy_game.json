{
"project": {
"name": "Monoblend Flying Syrnik",
"version": "1.0.0",
"type": "mobile_web_arcade_game",
"brand": "Monoblend Coffee",
"core_reference": "Flappy Bird-style one-touch obstacle game",
"objective": "Игрок управляет летящим сырником, проходит через препятствия и набирает скидку. Максимальная скидка 25% должна быть редким достижением и зависеть от дистанции, серии чистых прохождений, точности, стабильности управления и отсутствия подозрительных событий.",
"primary_reward": {
"type": "discount_percent",
"minimum_percent": 3,
"maximum_percent": 25
},
"theme": {
"main_character": "flying_syrnik",
"world": "stylized_chelsea_coffee_world",
"visual_direction": "premium, playful, absurd, polished, not childish",
"obstacle_examples": [
"forks",
"espresso_machine_groups",
"coffee_cups",
"steam_clouds",
"pigeons",
"milk_pitchers",
"croissant_arches",
"new_york_signage"
]
}
},
"game_session": {
"countdown_seconds": 3,
"maximum_active_duration_seconds": 45,
"minimum_rewardable_duration_seconds": 3,
"maximum_attempts_per_user_per_day": 3,
"rewarded_attempts_per_user_per_day": 1,
"practice_attempts_after_reward": true,
"start_behavior": {
"first_tap_starts_game": true,
"first_tap_also_applies_impulse": true,
"auto_start_after_countdown": false
},
"end_conditions": [
"character_collision",
"character_falls_below_play_area",
"character_exits_top_boundary",
"maximum_duration_reached",
"session_invalidated"
]
},
"input": {
"supported_events": [
"pointerdown"
],
"preferred_browser_api": "Pointer Events API",
"fallback_browser_api": "Touch Events API",
"primary_pointer_only": true,
"multi_touch_allowed": false,
"tap_behavior": {
"one_valid_pointerdown_equals_one_flap": true,
"pointerup_not_required_for_flap": true,
"minimum_interval_between_flaps_ms": 90,
"maximum_valid_flaps_per_second": 10,
"ignore_secondary_pointers": true
},
"active_area": {
"full_game_canvas_is_tappable": true,
"disable_text_selection": true,
"disable_context_menu": true,
"disable_double_tap_zoom": true,
"touch_action": "none"
}
},
"world": {
"coordinate_system": {
"design_width_units": 390,
"design_height_units": 844,
"scale_mode": "fit_height_with_safe_horizontal_crop",
"physics_use_normalized_units": true
},
"camera": {
"horizontal_scroll": true,
"vertical_scroll": false,
"camera_speed_is_world_speed": true,
"character_horizontal_position_percent": 30
},
"play_area": {
"top_safe_margin_percent": 8,
"bottom_safe_margin_percent": 12,
"minimum_visible_height_percent": 75
}
},
"character_physics": {
"character": {
"collision_shape": "circle",
"collision_radius_percent_of_sprite_width": 34,
"visual_sprite_width_percent_of_viewport": 14,
"rotation_enabled": true
},
"gravity": {
"initial_normalized_units_per_second_squared": 2.35,
"maximum_normalized_units_per_second_squared": 2.75
},
"flap_impulse": {
"initial_vertical_velocity_units_per_second": -0.72,
"minimum_vertical_velocity_after_flap": -0.72,
"maximum_vertical_velocity_after_flap": -0.58,
"stacking_allowed": false,
"rule": "Каждый валидный тап устанавливает вертикальную скорость в заданное отрицательное значение, а не бесконечно добавляет импульс."
},
"vertical_velocity": {
"maximum_fall_speed_units_per_second": 1.15,
"maximum_rise_speed_units_per_second": -0.8
},
"rotation": {
"maximum_upward_angle_degrees": -24,
"maximum_downward_angle_degrees": 78,
"rotation_response_seconds": 0.18
},
"frame_independence": {
"required": true,
"simulation_step": "fixed_timestep",
"fixed_step_hz": 120,
"maximum_catchup_steps_per_frame": 8,
"interpolation_for_rendering": true,
"rule": "Физика не должна зависеть от частоты экрана 60, 90 или 120 Гц."
}
},
"obstacles": {
"structure": {
"type": "paired_vertical_obstacles",
"passage_gap_between_obstacles": true,
"scoring_line_at_obstacle_center": true
},
"spawn": {
"initial_delay_ms": 1200,
"initial_horizontal_spacing_viewport_widths": 0.82,
"minimum_horizontal_spacing_viewport_widths": 0.62,
"random_spacing_variation_percent": 8,
"minimum_obstacles_visible_ahead": 2
},
"gap": {
"initial_gap_percent_of_play_area_height": 30,
"minimum_gap_percent_of_play_area_height": 20,
"maximum_gap_percent_of_play_area_height": 32,
"gap_reduction_per_difficulty_stage_percent": 1.2,
"minimum_top_or_bottom_clearance_percent": 12,
"vertical_position_randomization": true,
"maximum_center_shift_between_consecutive_gaps_percent": 22
},
"collision": {
"pixel_perfect_collision": false,
"use_simplified_hitboxes": true,
"visual_hitbox_padding_percent": 8,
"forgiving_collision_enabled": true,
"forgiving_collision_pixels_css": 3,
"collision_is_server_reconstructable": true
},
"special_obstacles": {
"enabled_after_score": 8,
"maximum_share_of_total_obstacles_percent": 20,
"types": [
{
"id": "moving_fork",
"vertical_movement": true,
"movement_amplitude_percent_of_gap": 16,
"movement_speed_hz": 0.35
},
{
"id": "steam_pulse",
"visual_distraction_only": true,
"changes_collision": false
},
{
"id": "double_gate",
"minimum_score_required": 16,
"two_gates_close_together": true
}
]
}
},
"difficulty": {
"model": "progressive_stages",
"difficulty_score_range": [
0,
1
],
"stages": [
{
"stage": 1,
"starts_at_passed_obstacles": 0,
"world_speed_multiplier": 1,
"gap_multiplier": 1,
"label": "TAKEOFF"
},
{
"stage": 2,
"starts_at_passed_obstacles": 5,
"world_speed_multiplier": 1.08,
"gap_multiplier": 0.95,
"label": "BREWING"
},
{
"stage": 3,
"starts_at_passed_obstacles": 10,
"world_speed_multiplier": 1.16,
"gap_multiplier": 0.9,
"label": "DIALED IN"
},
{
"stage": 4,
"starts_at_passed_obstacles": 16,
"world_speed_multiplier": 1.25,
"gap_multiplier": 0.84,
"label": "FULL PRESSURE"
},
{
"stage": 5,
"starts_at_passed_obstacles": 23,
"world_speed_multiplier": 1.34,
"gap_multiplier": 0.78,
"label": "REDLINE"
},
{
"stage": 6,
"starts_at_passed_obstacles": 31,
"world_speed_multiplier": 1.42,
"gap_multiplier": 0.72,
"label": "PERFECT FLIGHT"
}
],
"dynamic_adjustment": {
"enabled": true,
"can_make_game_easier_mid_session": false,
"can_only_increase_difficulty": true,
"based_on": [
"passed_obstacles",
"clean_pass_streak",
"session_duration"
],
"maximum_extra_speed_multiplier": 1.08
},
"anti_frustration": {
"first_three_obstacles_are_never_special": true,
"first_two_gaps_are_center_biased": true,
"no_extreme_gap_direction_reversal_before_score": 5,
"minimum_reaction_time_ms": 620
}
},
"scoring": {
"primary_metric": "passed_obstacles",
"secondary_metrics": [
"clean_passes",
"center_accuracy",
"longest_clean_streak",
"survival_time",
"input_efficiency"
],
"passed_obstacle": {
"points": 1,
"condition": "character_center_crosses_scoring_line_without_collision",
"count_only_once": true
},
"clean_pass": {
"description": "Прохождение ближе к центру ворот без касания forgiving-zone.",
"center_tolerance_percent_of_gap_height": 22,
"points": 1
},
"perfect_pass": {
"description": "Прохождение почти точно через центр ворот.",
"center_tolerance_percent_of_gap_height": 10,
"points": 1,
"visual_feedback": true
},
"streak": {
"minimum_clean_passes_to_start": 3,
"maximum_multiplier": 1.25,
"multiplier_curve": [
{
"clean_streak": 0,
"multiplier": 1
},
{
"clean_streak": 3,
"multiplier": 1.04
},
{
"clean_streak": 5,
"multiplier": 1.08
},
{
"clean_streak": 8,
"multiplier": 1.13
},
{
"clean_streak": 12,
"multiplier": 1.18
},
{
"clean_streak": 18,
"multiplier": 1.25
}
],
"reset_conditions": [
"non_clean_pass",
"collision"
]
}
},
"performance_metrics": {
"distance_score": {
"description": "Нелинейная оценка количества пройденных препятствий.",
"output_range": [
0,
1
],
"curve": [
{
"passed_obstacles": 0,
"score": 0
},
{
"passed_obstacles": 1,
"score": 0.08
},
{
"passed_obstacles": 3,
"score": 0.18
},
{
"passed_obstacles": 5,
"score": 0.3
},
{
"passed_obstacles": 8,
"score": 0.44
},
{
"passed_obstacles": 12,
"score": 0.58
},
{
"passed_obstacles": 16,
"score": 0.69
},
{
"passed_obstacles": 21,
"score": 0.79
},
{
"passed_obstacles": 27,
"score": 0.88
},
{
"passed_obstacles": 34,
"score": 0.95
},
{
"passed_obstacles": 42,
"score": 1
}
],
"interpolation": "monotonic_cubic_or_linear"
},
"accuracy_score": {
"description": "Доля ворот, пройденных близко к центру.",
"formula": "accuracy_score = 0.65 * clean_pass_ratio + 0.35 * perfect_pass_ratio",
"minimum_passed_obstacles_for_full_weight": 5,
"score_before_minimum_samples": 0.7
},
"streak_score": {
"description": "Оценка максимальной серии чистых прохождений.",
"curve": [
{
"longest_clean_streak": 0,
"score": 0
},
{
"longest_clean_streak": 2,
"score": 0.15
},
{
"longest_clean_streak": 4,
"score": 0.35
},
