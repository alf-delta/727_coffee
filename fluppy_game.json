"discount_25_requirements": {
"minimum_final_score": 99,
"minimum_passed_obstacles": 38,
"minimum_clean_pass_ratio": 0.78,
"minimum_perfect_pass_ratio": 0.3,
"minimum_longest_clean_streak": 14,
"minimum_survival_seconds": 32,
"minimum_input_efficiency_score": 0.72,
"maximum_security_risk_score": 15,
"all_conditions_required": true
},
"discount_24_requirements": {
"minimum_final_score": 97,
"minimum_passed_obstacles": 32,
"minimum_clean_pass_ratio": 0.72,
"minimum_longest_clean_streak": 11
},
"discount_23_requirements": {
"minimum_final_score": 94,
"minimum_passed_obstacles": 27,
"minimum_clean_pass_ratio": 0.66,
