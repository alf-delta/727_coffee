"collision_rules",
"discount_thresholds"
],
"fairness_rules": {
"same_seed_produces_same_game": true,
"no_impossible_obstacle_sequences": true,
"minimum_reaction_time_is_enforced": true,
"maximum_vertical_gap_shift_is_enforced": true
}
},
