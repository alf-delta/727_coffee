REWARD_TOKEN_SECRET=replace-with-a-long-random-secret
IDENTITY_HMAC_SECRET=replace-with-a-different-long-random-secret
COUPON_STAFF_PIN=replace-with-a-private-staff-pin
BUSINESS_TIME_ZONE=America/New_York
# Current launch mode. Restore phone + email bonus later with: phone-email-bonus
CONTACT_VERIFICATION_MODE=email-only

# Required shared storage in every deployed environment
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phone verification and coupon delivery (used only in phone-email-bonus mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
# Alternatively, use a single sender:
TWILIO_FROM_NUMBER=

# Email verification and coupon delivery (required in email-only mode)
RESEND_API_KEY=
EMAIL_FROM=Monoblend Coffee <coupons@your-verified-domain.com>
